---
import '@fontsource/raleway/latin-400.css';
import '@fontsource/raleway/latin-500.css';
import '@fontsource/raleway/latin-600.css';
import '@fontsource/raleway/latin-700.css';
import '@fontsource/open-sans/latin-600.css';
import '@fontsource/montserrat/latin-300.css';
import '@fontsource/montserrat/latin-600.css';
import '../styles/global.css';
import { business as b } from '../data/site';
interface Props { title: string; description?: string; home?: boolean }
const {title,description='Aladdin Donair Wholesale. Donair products, halal beef burgers and chicken. Based in Edmonton, serving Alberta since 2001.',home=false}=Astro.props;
const path=Astro.url.pathname;
---
<!doctype html>
<html lang="en-CA"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/><link rel="canonical" href={new URL(path,Astro.site)}/><link rel="icon" type="image/webp" href="/images/aladin-donair-icon.webp"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={new URL('/images/building-aladdin-cover.webp',Astro.site)}/><meta name="theme-color" content="#101010"/></head>
<body>
<a class="skip-link" href="#content">Skip to content</a>
<header class:list={['site-header',{overlay:home}]}>
 <div class="header-inner"><a class="brand" href="/" aria-label="Aladdin Donair Wholesale — Home"><img src="/images/aladdin-donair-logo-transparent2.webp" alt="Aladdin" width="696" height="206" loading="eager"/></a>
 <nav class="desktop-nav" aria-label="Main navigation"><a href="/" aria-current={path==='/'?'page':undefined}>Home</a><a href="/products/" aria-current={path!=='/'?'page':undefined}>Products</a><a href="/#contact">Contact</a></nav>
 <details class="mobile-nav"><summary aria-label="Main menu"><span>Menu</span><span aria-hidden="true">☰</span></summary><nav aria-label="Mobile navigation"><a href="/">Home</a><a href="/products/">Products</a><a href="/#contact">Contact</a></nav></details>
 </div>
</header>
<main id="content"><slot/></main>
<footer class="site-footer"><div class="footer-content"><img class="footer-icon" src="/images/aladin-donair-icon.webp" width="1024" height="939" alt="Aladdin Donair" loading="lazy"/><p>Aladdin Donair Wholesale Warehouse<br/>{b.address}</p><p><a href={b.officeLink}>{b.office}</a></p><a href={`mailto:${b.email}`}>{b.email}</a></div><div class="footer-credit"><div class="container">Powered By <a href="https://theorderguys.com/">Web Design Edmonton</a></div></div></footer>
</body></html>
